#!/bin/sh
# ЛР7: статический анализ перед каждым коммитом.
# Подключение: make -C lab7 install-hooks  (git config core.hooksPath .githooks)
# Пропустить:   git commit --no-verify
root="$(git rev-parse --show-toplevel)" || exit 1

if command -v go >/dev/null 2>&1; then
	exec "$root/lab7/scripts/pre-commit.sh"
fi

# Git for Windows без Go: проверки выполняются в WSL, где установлен Go.
if command -v wsl.exe >/dev/null 2>&1; then
	win_root="$(cd "$root" && pwd -W)"
	exec wsl.exe -e bash -lc "cd \"\$(wslpath -u '$win_root')\" && lab7/scripts/pre-commit.sh"
fi

echo "pre-commit: Go не найден, статический анализ невозможен (git commit --no-verify — пропустить)" >&2
exit 1
